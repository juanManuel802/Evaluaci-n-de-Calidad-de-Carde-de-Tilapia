package isi.shoppingCart.entities;

import org.junit.jupiter.api.Test;
import static org.junit.jupiter.api.Assertions.*;

class ProductTest {
    @Test
    void shouldCreateProductWithCorrectData() {
        Product product = new Product(1, "Laptop", 2500000.0, 5);
        assertEquals(1, product.getId());
        assertEquals("Laptop", product.getName());
        assertEquals(2500000.0, product.getPrice());
        assertEquals(5, product.getAvailableQuantity());
    }

    @Test
    void shouldChangePriceWhenNewPriceIsValid() {    
        Product product = new Product(1, "Audifonos", 3005.0, 8);

        product.changePrice(4000.0);
    
        assertEquals(4000.0, product.getPrice());
    }

    @Test
    void shouldRemainPriceWhenNewPriceIsNegative() {    
        double price = 2000.0;
        Product product = new Product(1, "Audifonos", price, 8);
    
        product.changePrice(-20.0);
    
        assertEquals(price, product.getPrice());
    }

    @Test
    void shouldIncreaseAvailableQuantityWhenQuantityIsValid() {    
        Product product = new Product(1, "Audifonos", 3000.0, 8);
    
        product.increaseAvailableQuantity(5);

        assertEquals(13, product.getAvailableQuantity());
    }

    @Test
    void shouldRemainAvailableQuantityWhenQuantityIsZero() {    
        int quantity = 8;
        Product product = new Product(1, "Audifonos", 3000.0, quantity);
    
        product.increaseAvailableQuantity(0);
    
        assertEquals(quantity, product.getAvailableQuantity());
    }

    @Test
    void shouldDecreaseAvailableQuantityWhenQuantityIsValid() {    
        Product product = new Product(1, "Audifonos", 3000.0, 8);
    
        boolean result = product.decreaseAvailableQuantity(8);
    
        assertTrue(result);
        assertEquals(0, product.getAvailableQuantity());
    }

    @Test
    void shouldRemainAvailableQuantityWhenQuantityIsNegative() {    
        int availableQuantity = 8;
        Product product = new Product(1, "Audifonos", 3000.0, availableQuantity);
    
        boolean result = product.decreaseAvailableQuantity(-5);
    
        assertFalse(result);
        assertEquals(availableQuantity, product.getAvailableQuantity());
    }

    @Test
    void shouldRemainAvailableQuantityWhenQuantityExceedsAvailable() {    
        int availableQuantity = 8;
        Product product = new Product(1, "Audifonos", 3000.0, availableQuantity);
    
        boolean result = product.decreaseAvailableQuantity(availableQuantity + 5);
    
        assertFalse(result);
        assertEquals(availableQuantity, product.getAvailableQuantity());
    }
}
